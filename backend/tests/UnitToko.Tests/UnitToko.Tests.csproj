<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <ProjectReference Include="../../src/UnitToko.Api/UnitToko.Api.csproj" />
    <ProjectReference Include="../../src/UnitToko.Worker/UnitToko.Worker.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/UnitToko.ImageDecoder/UnitToko.ImageDecoder.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../UnitToko.PersistenceProbe/UnitToko.PersistenceProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../contracts/openapi.json" Link="openapi.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyPersistenceProbe" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../UnitToko.PersistenceProbe/UnitToko.PersistenceProbe.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="PersistenceProbeOutput" />
    </MSBuild>
    <Error Condition="!Exists('@(PersistenceProbeOutput)')" Text="Build the matching persistence probe before copying test helpers." />
    <PropertyGroup><PersistenceProbeDirectory>@(PersistenceProbeOutput->'%(RootDir)%(Directory)')</PersistenceProbeDirectory></PropertyGroup>
    <ItemGroup>
      <PersistenceProbeFiles Include="$(PersistenceProbeDirectory)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(PersistenceProbeFiles)"
          DestinationFiles="@(PersistenceProbeFiles->'$(OutDir)PersistenceProbe/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyMigrationWorker" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../../src/UnitToko.Worker/UnitToko.Worker.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="MigrationWorkerOutput" />
    </MSBuild>
    <Error Condition="!Exists('@(MigrationWorkerOutput)')" Text="Build the matching migration worker before copying test helpers." />
    <PropertyGroup><MigrationWorkerDirectory>@(MigrationWorkerOutput->'%(RootDir)%(Directory)')</MigrationWorkerDirectory></PropertyGroup>
    <ItemGroup>
      <MigrationWorkerFiles Include="$(MigrationWorkerDirectory)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(MigrationWorkerFiles)"
          DestinationFiles="@(MigrationWorkerFiles->'$(OutDir)MigrationWorker/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyImageDecoder" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../../src/UnitToko.ImageDecoder/UnitToko.ImageDecoder.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="ImageDecoderOutput" />
    </MSBuild>
    <Error Condition="!Exists('@(ImageDecoderOutput)')" Text="Build the matching image decoder before copying test helpers." />
    <PropertyGroup><ImageDecoderDirectory>@(ImageDecoderOutput->'%(RootDir)%(Directory)')</ImageDecoderDirectory></PropertyGroup>
    <ItemGroup>
      <ImageDecoderFiles Include="$(ImageDecoderDirectory)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(ImageDecoderFiles)" DestinationFiles="@(ImageDecoderFiles->'$(OutDir)ImageDecoder/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
