<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>UnitToko.LocalPilot.EntryPoint</StartupObject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- Same pinned version as the isolated decoder; used only to turn the first demo's WebP photos into JPEG before upload. -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.2" />
    <ProjectReference Include="../../src/UnitToko.Api/UnitToko.Api.csproj" />
    <ProjectReference Include="../../src/UnitToko.ImageDecoder/UnitToko.ImageDecoder.csproj" ReferenceOutputAssembly="false" />
    <!-- The first demo's 200 products (names, descriptions, units, prices, groups, photo paths), SYNTHETIC. -->
    <EmbeddedResource Include="demo-products.json" LogicalName="demo-products.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- The bootstrap on a disposable test database (PilotBootstrap.InitializeDatabaseAsync) and the demo catalog. -->
    <InternalsVisibleTo Include="UnitToko.LocalPilot.Tests" />
  </ItemGroup>

  <!-- The pilot installs a private, pinned copy of this decoder build on first use (see PilotPhotos). -->
  <Target Name="CopyImageDecoder" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../../src/UnitToko.ImageDecoder/UnitToko.ImageDecoder.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="ImageDecoderOutput" />
    </MSBuild>
    <Error Condition="!Exists('@(ImageDecoderOutput)')" Text="Build the matching image decoder before copying it." />
    <PropertyGroup><ImageDecoderDirectory>@(ImageDecoderOutput->'%(RootDir)%(Directory)')</ImageDecoderDirectory></PropertyGroup>
    <ItemGroup>
      <ImageDecoderFiles Include="$(ImageDecoderDirectory)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(ImageDecoderFiles)" DestinationFiles="@(ImageDecoderFiles->'$(OutDir)ImageDecoder/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
