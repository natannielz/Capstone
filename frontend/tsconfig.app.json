{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-full/types/**/*.ts",
    ".next-full/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tests",
    "examples"
  ]
}
